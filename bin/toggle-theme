# File                  : toggle-theme
# Descrtiption          : Toggle macOS light/dark appearance.
# Author                : Serhat Teker <me@serhatteker.com>
# Date                  : 2022-04-23T15:41:00+0300 | 1650717660
# Last Modified Date    : 2026-06-15
# Notes                 : Only flips the macOS system appearance. dark-notify
# watches it and cascades the change to nvim (dark-notify plugin), tmux
# (tmux-dark-notify) and Ghostty (native theme = light:...,dark:...).
# Usage                 : $ ./toggle-theme
#
# or pass theme flag to use the specific theme:
# Light mode
# $ ./toggle-theme -l|--light|l|light
# Dark mode
# $ ./toggle-theme -d|--dark|d|dark
# =================================================================================================

# Bash safeties: exit on error, no unset variables, pipelines can't hide errors
set -o errexit
set -o nounset
set -o pipefail

macos_toggle() {
    if [[ ${target_mode} == "light" ]]; then
        osascript -l JavaScript -e "Application('System Events').appearancePreferences.darkMode = false" >/dev/null
    elif [[ ${target_mode} == "dark" ]]; then
        osascript -l JavaScript -e "Application('System Events').appearancePreferences.darkMode = true" >/dev/null
    fi
}

display_usage() {
    cat <<EOF
    Toggle the macOS appearance for developer workflow from one mode to another
Usages:

1. Just run without flag (toggles current mode):
$ ./toggle-theme

2. Pass a theme flag to force a specific mode:
For light mode:
$ ./toggle-theme -l|--light|l|light
For dark mode:
$ ./toggle-theme -d|--dark|d|dark
EOF
}

error_arg() {
    echo "Unknown argument(s) passed! <${@}>"
    display_usage
    exit 1
}

main() {
    local target_mode="dark" # Default theme mode is dark

    # No mode flag: invert the current appearance.
    if [[ "$#" -eq 0 ]]; then
        local theme="$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)"
        [[ "${theme}" =~ "Dark" ]] && local target_mode="light"
    # If theme mode passed use it
    elif [[ "$#" -eq 1 ]]; then
        case $1 in
        -d | --dark | d | dark) local target_mode="dark" ;;
        -l | --light | l | light) local target_mode="light" ;;
        -h | --help)
            display_usage
            exit 0
            ;;
        *) error_arg "$@" ;;
        esac
    else
        error_arg "$@"
    fi

    macos_toggle

    echo "Switched to ${target_mode} mode"
}

main "$@"
