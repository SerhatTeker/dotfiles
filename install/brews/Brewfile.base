brew "gnu-which"
brew "gnu-sed"
brew "lsd"
brew "luarocks"
brew "nvim"
brew "openssl"
brew "openssh"
brew "ripgrep"
brew "shellcheck"
brew "shfmt"
brew "tmux"
brew "tree"
brew "wget"
# Cask
cask "ghostty"
